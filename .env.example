# Voxhoo Clinic local environment example
# Copy this file to .env.local and replace the placeholder values before running the app.
GOOGLE_PLACES_API_KEY=your_google_places_api_key
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key
# Optional for Neon/Drizzle scripts only. The live app no longer requires this at runtime.
DATABASE_URL=postgresql://username:password@host.neon.tech/dbname?sslmode=require
